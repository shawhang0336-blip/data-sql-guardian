# ds_agent 运行配置示例（默认 llm_provider=scripted 离线全功能运行，请勿提交真实密钥 .env）

LLM_PROVIDER=scripted
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# LLM_API_KEY=replace_with_your_key
LLM_TIMEOUT=120
LLM_TOOL_CHOICE=auto

# 可选：指定真实 SAC 语料所在目录（默认自动探测同级目录 ../sql_explorer）
# SQL_EXPLORER_DIR=../sql_explorer

# 可选：应用管理库连接（本地默认 SQLite WAL，生产推荐 MySQL 8+）
# DATABASE_URL=sqlite:///./backend/var/ds_agent.db
# BLOB_DIR=./backend/var/blobs
